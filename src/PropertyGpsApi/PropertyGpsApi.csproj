<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PropertyGpsApi</RootNamespace>
    <UserSecretsId>property-gps-api</UserSecretsId>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The repositories and stores are internal by design; the tests still need to reach
         them, and widening them to public just for testing would be worse. -->
    <InternalsVisibleTo Include="PropertyGpsApi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
    <!-- Not used directly: Microsoft.Data.SqlClient 7.0.3 brings in 9.0.13, which has
         GHSA-846f-f764-76mx (high) and GHSA-2fmv-rv2c-59x7 (moderate), affecting 9.0.0-9.0.20.
         9.0.21 is the lowest patched release of the line SqlClient asks for. Drop this when
         SqlClient itself depends on a patched version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local developer credentials. Copied beside the exe so it is found when the app is
         launched from bin (which is what Visual Studio does), but NEVER included in a
         publish: production supplies these as environment variables. -->
    <Content Update="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
